  "description": "Paseo plugin: dropping a file or folder on the composer inserts its local path instead of uploading it.",
  "author": {
    "name": "Matteo Zampieri",
    "url": "https://matteozampieri.com"
  },
  "homepage": "https://github.com/themattvision/paseo-drop-path",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/themattvision/paseo-drop-path.git"
  },
  "license": "MIT",
  "files": [
    "paseo-plugin.json",
    "OVERVIEW.md",
    "OVERVIEW.*.md",
    "index.client.ts",
    "index.client.tsx",
    "index.server.ts",
    "index.server.tsx",
    "client/",
    "server/",
    "shared/"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.13.0",
